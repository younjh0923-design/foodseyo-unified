  {
    "case": "inferred evidence cannot override a source statement",
    "schema": "CanonicalMenuAnalysis",
    "fixture": "canonicalMenuAnalysis",
    "mutations": [
      {
        "operation": "add",
        "path": ["menuItemClaims", 4],
        "value": {
          "claimId": "90909090-9090-4090-8090-909090909090",
          "menuItemId": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
          "claim": {
            "kind": "heat",
            "value": "medium"
          },
          "basis": "inferred_from_source",
          "provenance": [
            {
              "kind": "menu_source",
              "sourceRef": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
              "sourceIndexes": [0]
            }
          ],
          "recordedAt": "2026-07-18T16:10:00.000Z"
        }
      },
      {
        "operation": "replace",
        "path": ["effectiveProfiles", 0, "inputClaimIds", 0],
        "value": "90909090-9090-4090-8090-909090909090"
      },
      {
        "operation": "replace",
        "path": ["effectiveProfiles", 0, "fields", "heat", "basis"],
        "value": "inferred_from_source"
      },
      {
        "operation": "replace",
        "path": ["effectiveProfiles", 0, "fields", "heat", "value"],
        "value": "medium"
      },
      {
        "operation": "replace",
        "path": ["effectiveProfiles", 0, "fields", "heat", "claimIds", 0],
        "value": "90909090-9090-4090-8090-909090909090"
      }
    ],
    "expectedIssues": [
      {
        "code": "inference_cannot_override_source_statement",
        "path": ["effectiveProfiles", 0, "fields", "heat"]
      }
    ]
  },
