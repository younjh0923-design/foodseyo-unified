{
  "name": "foodseyo-unified",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Greenfield unified Foodseyo submission repository",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "pnpm --recursive --if-present typecheck",
    "validate:boundary-dtos": "tsx scripts/validate-boundary-dtos.ts",
    "validate:contracts": "tsx scripts/validate-contracts.ts",
    "validate:module-interfaces": "tsx scripts/validate-module-interfaces.ts",
    "validate:source-acquisition": "tsx scripts/validate-source-acquisition.ts",
    "validate:security": "tsx scripts/validate-repository-security.ts",
    "verify": "pnpm typecheck && pnpm validate:contracts && pnpm validate:boundary-dtos && pnpm validate:module-interfaces && pnpm validate:source-acquisition && pnpm validate:security"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
