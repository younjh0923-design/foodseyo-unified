{
  "name": "foodseyo-unified",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Greenfield unified Foodseyo submission repository",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "pnpm --recursive --if-present typecheck",
    "validate:boundary-dtos": "tsx scripts/validate-boundary-dtos.ts",
    "validate:contracts": "tsx scripts/validate-contracts.ts",
    "validate:module-interfaces": "tsx scripts/validate-module-interfaces.ts",
    "validate:restaurant-resolution": "pnpm --filter @foodseyo/restaurant-resolution validate:foundation",
    "validate:source-acquisition": "pnpm --filter @foodseyo/source-acquisition validate:foundation",
    "validate:u2-data-pipeline": "tsx scripts/validate-u2-data-pipeline.ts",
    "validate:web-foundation": "pnpm --filter @foodseyo/web test",
    "test:unit": "pnpm validate:contracts && pnpm validate:boundary-dtos",
    "test:integration": "pnpm validate:module-interfaces",
    "test:workspace": "pnpm --recursive --if-present test",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:workspace",
    "validate:ci": "tsx scripts/validate-ci-foundation.ts",
    "validate:network-boundary": "node scripts/validate-network-boundary.mjs",
    "validate:security": "tsx scripts/validate-repository-security.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm validate:source-acquisition && pnpm validate:restaurant-resolution && pnpm validate:u2-data-pipeline && pnpm validate:web-foundation && pnpm validate:security && pnpm validate:ci && pnpm validate:network-boundary"
  },
  "devDependencies": {
    "@foodseyo/contracts": "workspace:*",
    "@foodseyo/database": "workspace:*",
    "@foodseyo/menu-analysis": "workspace:*",
    "@foodseyo/merge-policy": "workspace:*",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
