# Server runtime only. Never commit real values.
FOODSEYO_RUNTIME_ENV=development
APP_BASE_URL=http://localhost:3000
# Environment-scoped pooled Neon runtime connection; least-privilege role only.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MENU_EXTRACTION_MODEL=
OPENAI_WEB_SEARCH_MODEL=
OPENAI_EXPLANATION_MODEL=
GOOGLE_PLACES_API_KEY=
# Feature flags are optional and fail closed. Only the exact value true enables.
FEATURE_RESTAURANT_RESOLUTION=false
FEATURE_WEB_SEARCH_DISCOVERY=false
FEATURE_DISH_KNOWLEDGE_REUSE=false
LOG_LEVEL=info
